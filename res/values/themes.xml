<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- тема приложения: системный Material + фирменные диалоги -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">#0B0E13</item>
        <item name="android:navigationBarColor">#0B0E13</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
    </style>

    <!-- фирменный стиль диалогов: тёмная карточка в духе приложения -->
    <style name="AppDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_card</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
        <item name="android:textColorAlertDialogListItem">@color/textPrimary</item>
    </style>
</resources>
