<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="Иконка"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-medium"
        android:text="Загрузка обновления"
        android:textColor="@color/textPrimary"
        android:textSize="17sp"/>

    <TextView
        android:id="@+id/otaProgressVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_chip"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:textColor="@color/textSecondary"
        android:textSize="12sp"
        android:text="Версия"/>

    <!-- Проценты крупно -->
    <TextView
        android:id="@+id/otaPct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:text="0%"
        android:textColor="@color/accent"
        android:textSize="28sp"/>

    <TextView
        android:id="@+id/otaDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Подготовка…"
        android:textColor="@color/textSecondary"
        android:textSize="12.5sp"/>

    <ProgressBar
        android:id="@+id/otaBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="14dp"
        android:max="10000"
        android:progressTint="@color/accent"
        android:progressBackgroundTint="@color/surface2"
        android:indeterminate="false"/>

    <Button
        android:id="@+id/otaCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/btn_ghost"
        android:fontFamily="sans-serif-medium"
        android:padding="12dp"
        android:text="Отменить"
        android:textAllCaps="false"
        android:textColor="@color/danger"
        android:textSize="13.5sp"/>

</LinearLayout>
