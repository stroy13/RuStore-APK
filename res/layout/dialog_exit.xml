<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="Иконка"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="sans-serif-medium"
        android:text="Выйти из приложения?"
        android:textColor="@color/textPrimary"
        android:textSize="17sp"
        android:gravity="center"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Вы действительно хотите закрыть приложение?"
        android:textColor="@color/textSecondary"
        android:textSize="13sp"
        android:lineSpacingExtra="1dp"/>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/exitStay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/btn_ghost"
            android:fontFamily="sans-serif-medium"
            android:padding="12dp"
            android:text="Остаться"
            android:textAllCaps="false"
            android:textColor="@color/textSecondary"
            android:textSize="13.5sp"/>

        <Button
            android:id="@+id/exitLeave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/btn_accent"
            android:fontFamily="sans-serif-medium"
            android:padding="12dp"
            android:text="Выйти"
            android:textAllCaps="false"
            android:textColor="@color/textPrimary"
            android:textSize="13.5sp"/>

    </LinearLayout>

</LinearLayout>
