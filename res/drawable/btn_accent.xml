<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#26FFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape><corners android:radius="13dp"/><solid android:color="#141A26"/></shape>
            </item>
            <item android:state_pressed="true">
                <shape><corners android:radius="13dp"/><solid android:color="@color/accentPressed"/></shape>
            </item>
            <item>
                <shape><corners android:radius="13dp"/><solid android:color="@color/accent"/></shape>
            </item>
        </selector>
    </item>
</ripple>
