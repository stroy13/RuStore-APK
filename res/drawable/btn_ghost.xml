<?xml version="1.0" encoding="utf-8"?>
<!-- Вторичная кнопка: прозрачная с рамкой (например «Позже» в баннере OTA) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1AFFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape>
                    <corners android:radius="13dp"/>
                    <solid android:color="#00000000"/>
                    <stroke android:width="1dp" android:color="#223046"/>
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape>
                    <corners android:radius="13dp"/>
                    <solid android:color="#14FFFFFF"/>
                    <stroke android:width="1dp" android:color="@color/border"/>
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="13dp"/>
                    <solid android:color="#00000000"/>
                    <stroke android:width="1dp" android:color="@color/border"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
